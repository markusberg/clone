{
  "name": "@markusberg/clone",
  "description": "deep cloning of objects and arrays",
  "tags": [
    "clone",
    "object",
    "array",
    "function",
    "date"
  ],
  "version": "3.0.0",
  "repository": {
    "type": "git",
